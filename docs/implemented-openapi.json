            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "Batch"
      },
      "Body_upload_api_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
