            "minLength": 2,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Tag"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Pump",
              "Compressor",
              "Motor",
              "Turbine"
            ],
            "title": "Kind",
            "default": "Pump"
          },
          "site": {
            "type": "string",
            "title": "Site"
          },
          "location": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Location"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ],
            "title": "Criticality",
            "default": "High"
          },
          "threshold": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Threshold",
            "default": 4.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tag",
          "name",
          "site",
          "location"
        ],
        "title": "AssetCreate"
      },
      "Batch": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/TelemetryRecord"
