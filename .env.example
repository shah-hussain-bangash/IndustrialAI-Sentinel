# Local reference application. Copy to .env and run uvicorn --env-file .env.
DEMO_MODE=true
DEMO_PASSWORD=SentinelDemo!2026
AUTO_CREATE_SCHEMA=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5187,http://localhost:5187,http://127.0.0.1:8127,http://localhost:8127
# Default SQLite is created under ./data. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@127.0.0.1:5432/sentinel
# With demo disabled, initialize an empty database with:
# INITIAL_ADMIN_EMAIL=your-admin@example.invalid
# INITIAL_ADMIN_PASSWORD=SET_A_STRONG_PRIVATE_PASSWORD

# Optional Gmail account invitations/recovery. Private credentials belong only in .env.
SENTINEL_ACCOUNT_EMAIL_ENABLED=false
SENTINEL_MAIL_SENDER=
SENTINEL_MAIL_APP_PASSWORD=
SENTINEL_PUBLIC_URL=
SENTINEL_ALLOW_LOCAL_MAIL_LINKS=false

# Administrator MFA encryption key. Keep private; default key file is data/security/mfa.key.
# SENTINEL_MFA_KEY_FILE=C:/private/sentinel/mfa.key
